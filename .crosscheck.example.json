{
  "enabled": true,
  "provider": "auto",
  "model": null,
  "threshold": "warn",
  "fail_open": true,
  "max_rounds": 2,
  "timeout_sec": 120,
  "max_diff_bytes": 200000,
  "command": null,
  "include": [
    "*"
  ],
  "exclude": [
    "*/node_modules/*",
    "*/dist/*",
    "*/build/*",
    "*/.venv/*",
    "*/vendor/*",
    "*.min.js",
    "*.min.css",
    "*.map",
    "*.lock",
    "*-lock.json",
    "*.lockb",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "poetry.lock",
    "Cargo.lock",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.svg",
    "*.ico",
    "*.pdf",
    "*.zip",
    "*.gz",
    "*.env",
    "*.env.*",
    "*.snap"
  ]
}
